# Required in production. 32+ random characters. Changing it makes stored phone numbers unreadable.
APP_SECRET=
# Postgres connection string. Leave empty locally to use embedded PGlite.
DATABASE_URL=
# Optional PEM CA for providers with a private certificate authority.
DATABASE_CA=
# Claude. Without a key the bot still answers from its sourced offline cards.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
MAX_AI_PER_DAY=2000
# WhatsApp Business Cloud API (Meta). All optional until the number is approved.
WA_TOKEN=
WA_PHONE_ID=
WA_BOT_NUMBER=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_TEMPLATE=
WA_GRAPH_VERSION=v23.0
# Local demo only. Never set in production.
SEED_DEMO=
SEED_ADMIN_SECRET=
